{
  "name": "astrology-worker-example",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2024-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "worker-build --release" },
  "vars": {
    "EPHEMERIS_KEY": "cheb/v1/cheb.bin",
    "EPHEMERIS_SHA256": "37773a57791bbadcb04ffe61348a8293f15e12831a7f69b7302170edbb2fe36e",
    "KERNEL_COVERAGE_MIN_YEAR": "1849",
    "KERNEL_COVERAGE_MAX_YEAR": "2150"
  },
  "r2_buckets": [{ "binding": "EPHEMERIS", "bucket_name": "astrology-ephemeris" }]
}
